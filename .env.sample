# .env
# Server Configuration
INOOVAZAP_PORT=8080
INOOVAZAP_ADDRESS=0.0.0.0

# Token for INOOVAZAP Admin
INOOVAZAP_ADMIN_TOKEN=1234ABCD

# Encryption key for sensitive data (32 bytes for AES-256)
INOOVAZAP_GLOBAL_ENCRYPTION_KEY=your_32_byte_encryption_key_here

# Global HMAC Key for webhook signing (minimum 32 characters)
INOOVAZAP_GLOBAL_HMAC_KEY=your_global_hmac_key_here_minimum_32_chars

# Global webhook URL
INOOVAZAP_GLOBAL_WEBHOOK=https://example.com/webhook

# "json" or "form" for the default
WEBHOOK_FORMAT=json

# INOOVAZAP Session Configuration
SESSION_DEVICE_NAME=INOOVAZAP

# Database configuration
DB_USER=INOOVAZAP
DB_PASSWORD=INOOVAZAP
DB_NAME=INOOVAZAP
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=false
TZ=America/Sao_Paulo

# RabbitMQ configuration Optional
RABBITMQ_URL=amqp://INOOVAZAP:INOOVAZAP@localhost:5672/%2F
RABBITMQ_QUEUE=whatsapp_events
